{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(favicon\\.png|logo\\.png|.*\\.ico|.*\\.svg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}
